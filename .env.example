# The compose file exposes 55432 because 5432/5433 are often already taken.
DATABASE_URL=postgres://nswbus:nswbus@localhost:55432/nswbus

# Transport for NSW Open Data Hub key. Sent as: Authorization: apikey <key>
TFNSW_API_KEY=

# Feed endpoints (override only if TfNSW changes them)
GTFS_BUS_URL=https://api.transport.nsw.gov.au/v1/gtfs/schedule/buses
VEHICLE_POSITIONS_URL=https://api.transport.nsw.gov.au/v1/gtfs/vehiclepos/buses
TRIP_UPDATES_URL=https://api.transport.nsw.gov.au/v1/gtfs/realtime/buses

# Collection cadence
POSITION_INTERVAL_MS=15000
TRIP_UPDATE_INTERVAL_MS=60000
RETENTION_DAYS=30
