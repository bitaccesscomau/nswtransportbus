{
	"name": "nswtransportbus",
	"version": "0.0.1",
	"private": true,
	"type": "module",
	"imports": {
		"#lib": "./src/lib/index.js",
		"#lib/*": "./src/lib/*"
	},
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"start": "bun ./build/index.js",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"db:up": "docker compose up -d",
		"db:down": "docker compose down",
		"db:generate": "drizzle-kit generate",
		"db:migrate": "drizzle-kit migrate",
		"db:studio": "drizzle-kit studio",
		"gtfs:import": "bun scripts/gtfs-import.ts",
		"collect": "bun scripts/collect.ts",
		"retention": "bun scripts/retention.ts",
		"busyness:derive": "bun scripts/derive-busyness.ts",
		"suburbs:import": "bash scripts/import-suburbs.sh",
		"traffic:import": "bun scripts/import-traffic-lights.ts",
		"slowdowns:derive": "bun scripts/derive-slowdowns.ts"
	},
	"devDependencies": {
		"@internationalized/date": "^3.12.4",
		"@lucide/svelte": "^1.72.0",
		"@sveltejs/adapter-node": "^6.0.2",
		"@sveltejs/kit": "^3.0.0",
		"@sveltejs/vite-plugin-svelte": "^7.2.0",
		"@tailwindcss/vite": "^4.3.5",
		"@types/node": "^26.6.6",
		"bits-ui": "^2.21.0",
		"cn": "^0.5.2",
		"drizzle-kit": "^0.31.11",
		"shadcn-svelte": "^1.8.1",
		"svelte": "^5.57.2",
		"svelte-check": "^4.6.0",
		"tailwind-variants": "^3.3.1",
		"tailwindcss": "^4.3.5",
		"tw-animate-css": "^1.4.0",
		"typescript": "^6.0.3",
		"vite": "^8.3.0"
	},
	"dependencies": {
		"@fontsource-variable/inter": "^5.3.0",
		"csv-parse": "^7.0.3",
		"drizzle-orm": "^0.45.4",
		"fflate": "^0.8.3",
		"maplibre-gl": "^6.18.0",
		"postgres": "^4.1.1",
		"protobufjs": "^8.8.1",
		"xlsx": "^0.18.5"
	},
	"packageManager": "bun@1.4.4"
}
